[Unit]
Description=Wheel Prophet poller (Squeekchain round calls)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/wheel-prophet
EnvironmentFile=-/home/ubuntu/wheel-prophet/.env
ExecStart=/usr/bin/node poller.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
